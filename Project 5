
#include <stdio.h>


void main()
{
    FILE *fp;
    char name[300];



    // 1. Writing data into file
    fp = fopen("feed back.txt", "w");

    if (fp == NULL)
    {
        printf("File cannot be opened");
    
        return;
    }

    fprintf(fp, "before this new trainer we struggled to learn C language, because there is no specific staff assigned for us we learned something they taught randomly but tht we got a specific staff now we are better  ");

    fclose(fp);

    printf("Data written successfully\n");


    // 2. Appending data into file
    fp = fopen("feed back.txt", "a");

    if (fp == NULL)
    {
        printf("File cannot be opened");
    
        return;
    }

    fprintf(fp, "\nafter the new trainer,we now learning correctly and according to the syllabus, i think we will do our best ");

    fclose(fp);

    printf("Data appended successfully\n");


    // 3. Reading data from file
    fp = fopen("feed back.txt", "r");

    if (fp == NULL)
    {
        printf("File cannot be opened");
    
        return;
    }

    printf("\nFile Contents:\n");

    while (fgets(name, sizeof(name), fp) != NULL)
    {
        printf("%s", name);
    }

    fclose(fp);

    
}
